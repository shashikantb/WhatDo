generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["jsonProtocol", "fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum PostType {
  YES_NO
  MULTIPLE_CHOICE
  A_VS_B
  RATING
  EMOJI
  POLL
  PRICE
  DECISION
  PREDICTION
}

enum PostStatus {
  DRAFT
  PENDING_MODERATION
  PUBLISHED
  CLOSED
  HIDDEN
  REMOVED
}

enum ReportType {
  POST
  COMMENT
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  NUDITY
  VIOLENCE
  SCAM
  MISINFORMATION
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  VOTE
  COMMENT
  REPLY
  FOLLOW
  LIKE
  PREDICTION_RESOLVED
  TRENDING
  MODERATION
}

enum ModerationAction {
  APPROVED
  HIDDEN
  REMOVED
  WARNING
  SUSPENDED
  BANNED
  FEATURED
  UNFEATURED
}

enum AdPlacement {
  FEED_EVERY_N
  BANNER
  SPONSORED_NATIVE
  DESKTOP_SIDEBAR
}

enum PostMediaType {
  IMAGE
  VIDEO
  GIF
  LINK
}

model User {
  id                      String            @id @default(cuid())
  email                   String            @unique
  username                String            @unique
  displayName             String?
  avatarUrl               String?
  bio                     String?
  passwordHash            String?
  role                    Role              @default(USER)
  opinionScore            Int               @default(0)
  totalVotes              Int               @default(0)
  totalPosts              Int               @default(0)
  predictionsMade         Int               @default(0)
  predictionsCorrect      Int               @default(0)
  isVerified              Boolean           @default(false)
  isSuspended             Boolean           @default(false)
  isBanned                Boolean           @default(false)
  suspensionExpiresAt     DateTime?
  banReason               String?
  lastActiveAt            DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  accounts                Account[]
  sessions                Session[]
  posts                   Post[]            @relation("PostCreator")
  moderatedPosts          Post[]            @relation("PostModerator")
  comments                Comment[]
  commentLikes            CommentLike[]
  following               Follow[]          @relation("UserFollows")
  followers               Follow[]          @relation("UserFollowers")
  likes                   Like[]
  savedPosts              SavedPost[]
  votes                   Vote[]
  predictionResults       PredictionResult[]
  reported                Report[]          @relation("Reporter")
  assignedReports         Report[]          @relation("AssignedModerator")
  reportsAgainst          Report[]          @relation("ReportedUser")
  notifications           Notification[]    @relation("NotificationRecipient")
  notificationActors      Notification[]    @relation("NotificationActor")
  resolvedPredictions     Prediction[]      @relation("PredictionResolvedBy")
  moderationEvents        ModerationEvent[] @relation("ModerationActor")
  moderationEventsAgainst ModerationEvent[] @relation("ModeratedUser")
  blockedUsers            UserBlock[]       @relation("Blocker")
  blockedByUsers          UserBlock[]       @relation("Blocked")
  mutedUsers              UserMute[]        @relation("Muter")
  mutedByUsers            UserMute[]        @relation("Muted")
  analyticsEvents         AnalyticsEvent[]
  preferences             UserPreferences?
  categoryInterests       UserCategoryInterest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String                  @id @default(cuid())
  name        String                  @unique
  slug        String                  @unique
  icon        String?
  color       String?
  description String?
  postCount   Int                     @default(0)
  sortOrder   Int                     @default(0)
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())

  posts       Post[]
  tags        Tag[]
  interests   UserCategoryInterest[]
}

model Tag {
  id         String    @id @default(cuid())
  name       String    @unique
  slug       String    @unique
  categoryId String?
  postCount  Int       @default(0)
  createdAt  DateTime  @default(now())

  category   Category? @relation(fields: [categoryId], references: [id])
  posts      PostTag[]
}

model Post {
  id                    String              @id @default(cuid())
  slug                  String              @unique
  creatorId             String
  categoryId            String?
  type                  PostType
  question              String              @db.Text
  isAnonymous           Boolean             @default(false)
  allowComments         Boolean             @default(true)
  status                PostStatus          @default(PUBLISHED)
  isClosed              Boolean             @default(false)
  closeVotingAt         DateTime?
  voteCount             Int                 @default(0)
  viewCount             Int                 @default(0)
  commentCount          Int                 @default(0)
  likeCount             Int                 @default(0)
  shareCount            Int                 @default(0)
  saveCount             Int                 @default(0)
  controversyScore      Decimal?
  viralityScore         Decimal?
  trendingScore         Decimal?
  expiresAt             DateTime?
  isFeatured            Boolean             @default(false)
  isSponsored           Boolean             @default(false)
  sponsorName           String?
  sponsorLink           String?
  predictedOutcome      String?
  predictionResolvedAt  DateTime?
  predictionCorrect     Boolean?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  moderatedBy           String?

  creator               User                @relation("PostCreator", fields: [creatorId], references: [id])
  category              Category?           @relation(fields: [categoryId], references: [id])
  moderator             User?               @relation("PostModerator", fields: [moderatedBy], references: [id])
  media                 PostMedia[]
  options               PostOption[]
  votes                 Vote[]
  comments              Comment[]
  likes                 Like[]
  savedPosts            SavedPost[]
  tags                  PostTag[]
  reports               Report[]            @relation("ReportedPost")
  notifications         Notification[]
  prediction            Prediction?
  moderationEvents      ModerationEvent[]   @relation("ModerationPost")

  @@index([creatorId, createdAt(sort: Desc)])
  @@index([categoryId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([isFeatured, trendingScore(sort: Desc)])
}

model PostMedia {
  id             String        @id @default(cuid())
  postId         String
  type           PostMediaType
  url            String
  thumbnailUrl   String?
  posterUrl      String?
  width          Int?
  height         Int?
  duration       Int?
  mimeType       String?
  fileSize       Int?
  sortOrder      Int           @default(0)
  metadata       Json?
  createdAt      DateTime      @default(now())

  post           Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sortOrder])
}

model PostOption {
  id                     String             @id @default(cuid())
  postId                 String
  label                  String
  value                  String
  imageUrl               String?
  color                  String?
  voteCount              Int                @default(0)
  sortOrder              Int

  post                   Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes                  Vote[]             @relation("VoteOption")
  correctForPredictions  Prediction[]       @relation("PredictionCorrectOption")
  predictionResults      PredictionResult[] @relation("PredictionResultOption")

  @@unique([postId, sortOrder])
}

model Vote {
  id                String        @id @default(cuid())
  postId            String
  userId            String
  optionId          String?
  ratingValue       Int?
  emojiValue        String?
  priceValue        Decimal?
  weight            Decimal?
  deviceFingerprint String?
  ipHash            String?
  isConfirmed       Boolean?      @default(true)
  createdAt         DateTime      @default(now())

  post              Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  option            PostOption?   @relation("VoteOption", fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([userId, postId])
  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model Comment {
  id               String            @id @default(cuid())
  postId           String
  creatorId        String
  parentId         String?
  text             String            @db.VarChar(2000)
  likeCount        Int               @default(0)
  replyCount       Int               @default(0)
  isApproved       Boolean           @default(true)
  isHidden         Boolean           @default(false)
  isDeleted        Boolean           @default(false)
  reports_count    Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  post             Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  creator          User              @relation(fields: [creatorId], references: [id])
  parent           Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies          Comment[]         @relation("CommentReplies")
  likes            CommentLike[]
  reports          Report[]          @relation("ReportedComment")
  moderationEvents ModerationEvent[] @relation("ModerationComment")
  notifications    Notification[]

  @@index([postId, createdAt(sort: Desc)])
  @@index([creatorId, createdAt])
  @@index([parentId, createdAt])
}

model CommentLike {
  id         String   @id @default(cuid())
  commentId  String
  userId     String
  createdAt  DateTime @default(now())

  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model Follow {
  id           String   @id @default(cuid())
  followerId   String
  followingId  String
  createdAt    DateTime @default(now())

  follower     User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following    User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

model Like {
  id         String   @id @default(cuid())
  postId     String
  userId     String
  createdAt  DateTime @default(now())

  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model SavedPost {
  id         String   @id @default(cuid())
  postId     String
  userId     String
  createdAt  DateTime @default(now())

  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PostTag {
  id         String   @id @default(cuid())
  postId     String
  tagId      String
  createdAt  DateTime @default(now())

  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
}

model Report {
  id                  String            @id @default(cuid())
  type                ReportType
  reporterId          String
  reportedPostId      String?
  reportedCommentId   String?
  reportedUserId      String?
  reason              ReportReason
  details             String?           @db.Text
  status              ReportStatus      @default(OPEN)
  assignedModeratorId String?
  moderatorNote       String?           @db.Text
  resolution          String?           @db.Text
  actionTaken         ModerationAction?
  resolvedAt          DateTime?
  createdAt           DateTime          @default(now())

  reporter            User              @relation("Reporter", fields: [reporterId], references: [id])
  assignedModerator   User?             @relation("AssignedModerator", fields: [assignedModeratorId], references: [id])
  reportedPost        Post?             @relation("ReportedPost", fields: [reportedPostId], references: [id])
  reportedComment     Comment?          @relation("ReportedComment", fields: [reportedCommentId], references: [id])
  reportedUser        User?             @relation("ReportedUser", fields: [reportedUserId], references: [id])
  moderationEvents    ModerationEvent[] @relation("ModerationReport")

  @@index([status, createdAt(sort: Desc)])
  @@index([reporterId, createdAt])
}

model Notification {
  id           String   @id @default(cuid())
  recipientId  String
  type         NotificationType
  actorId      String?
  postId       String?
  commentId    String?
  payload      Json?
  isRead       Boolean  @default(false)
  readAt       DateTime?
  createdAt    DateTime @default(now())

  recipient    User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor        User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  post         Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt(sort: Desc)])
}

model Prediction {
  id              String        @id @default(cuid())
  postId          String        @unique
  closingTime     DateTime?
  resolutionDate  DateTime?
  correctOptionId String?
  isResolved      Boolean       @default(false)
  resolvedBy      String?
  resolvedAt      DateTime?

  post            Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  correctOption   PostOption?   @relation("PredictionCorrectOption", fields: [correctOptionId], references: [id], onDelete: SetNull)
  resolver        User?         @relation("PredictionResolvedBy", fields: [resolvedBy], references: [id])
  results         PredictionResult[]

  @@index([isResolved, resolutionDate])
}

model PredictionResult {
  id             String     @id @default(cuid())
  predictionId   String
  userId         String
  votedOptionId  String
  isCorrect      Boolean?
  awardedScore   Int        @default(0)
  processed      Boolean    @default(false)
  createdAt      DateTime   @default(now())

  prediction     Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  votedOption    PostOption @relation("PredictionResultOption", fields: [votedOptionId], references: [id], onDelete: Cascade)

  @@unique([predictionId, userId])
}

model ModerationEvent {
  id          String   @id @default(cuid())
  moderatorId String?
  postId      String?
  commentId   String?
  userId      String?
  reportId    String?
  action      ModerationAction
  reason      String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  moderator   User?    @relation("ModerationActor", fields: [moderatorId], references: [id])
  post        Post?    @relation("ModerationPost", fields: [postId], references: [id], onDelete: SetNull)
  comment     Comment? @relation("ModerationComment", fields: [commentId], references: [id], onDelete: SetNull)
  user        User?    @relation("ModeratedUser", fields: [userId], references: [id])
  report      Report?  @relation("ModerationReport", fields: [reportId], references: [id])

  @@index([moderatorId, createdAt])
  @@index([action, createdAt])
}

model UserBlock {
  id         String   @id @default(cuid())
  blockerId  String
  blockedId  String
  reason     String?
  createdAt  DateTime @default(now())

  blocker    User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model UserMute {
  id         String    @id @default(cuid())
  muterId    String
  mutedId    String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  muter      User      @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted      User      @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
}

model AdConfiguration {
  id              String      @id @default(cuid())
  placement       AdPlacement
  name            String
  isEnabled       Boolean     @default(true)
  contentJson     Json?
  linkUrl         String?
  scheduleStart   DateTime?
  scheduleEnd     DateTime?
  priority        Int         @default(0)
  everyNPosts     Int         @default(10)
  impressionCount Int         @default(0)
  clickCount      Int         @default(0)
  budgetClicks    Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([placement, name])
  @@index([placement, isEnabled, priority])
}

model AnalyticsEvent {
  id                 String   @id @default(cuid())
  userId             String?
  sessionId          String?
  eventType          String
  properties         Json?
  pageUrl            String?
  referrer           String?
  userAgent          String?
  ipHash             String?
  deviceFingerprint  String?
  createdAt          DateTime @default(now())

  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  emailNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  marketingEmails       Boolean  @default(false)
  nsfwAllowed           Boolean  @default(false)
  matureContentAllowed  Boolean  @default(false)
  autoPlayVideos        Boolean  @default(true)
  dataSaverMode         Boolean  @default(false)
  theme                 String?  @default("system")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserCategoryInterest {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  weight     Decimal  @default(1.0)
  viewCount  Int      @default(0)
  voteCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
