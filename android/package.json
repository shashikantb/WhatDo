{
  "name": "whatdo-android",
  "version": "1.0.0",
  "private": true,
  "description": "WHATDO Android application (Capacitor shell over the existing WhatDo web app + backend).",
  "scripts": {
    "sync": "cap sync android",
    "copy": "cap copy android",
    "open": "cap open android",
    "assets": "capacitor-assets generate --android",
    "build:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "build:release-bundle": "cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.19",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/network": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.6.3"
  }
}
