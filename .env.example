# ============================================================
# WHATDO — Production Environment Variables (Vercel + Neon + Cloudflare R2)
# ============================================================
# Copy this file to `.env.local` for local dev:
#   cp .env.example .env.local
#
# Paste ALL variables below into the Vercel Project Settings →
#   Environment Variables (Production / Preview / Development).
#
# === CREDENTIAL SECURITY =====================================
# NEVER commit .env.local / real secrets to git.
# `.env*` is already in .gitignore.
# ============================================================

# ============================================================
# 1. NEXT.JS / APP BASE (required always)
# ============================================================
# NODE_ENV=production set automatically by Vercel.
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=local
# Canonical site URL with NO trailing slash.
# Local: http://localhost:3000
# Vercel Production: https://whatdo.app (or https://<project>.vercel.app)
# Vercel Preview: https://<branch>-<project>-<id>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=WHATDO
NEXT_PUBLIC_SUPPORT_EMAIL=hello@whatdo.app

# ============================================================
# 2. DATABASE — Neon Postgres (serverless)
# ============================================================
# Go to neon.tech → Create Project → Postgres 16 → Region ap-southeast-1 (Singapore).
#
# Neon shows TWO connection strings. Use them correctly:
#
#   A) Pooled connection  →  DATABASE_URL
#      (for the Next.js app / tRPC server — uses PgBouncer pooler, works with
#       many concurrent serverless functions)
#   B) Direct connection  →  DIRECT_DATABASE_URL
#      (for migrations / schema pushes / prisma studio — 1:1 direct TCP socket,
#       lets you run DDL that pooled connections block)
#
# Both strings already include sslmode=require; paste them exactly as copied.
#
# Examples (replace with your real values):
#   DATABASE_URL="postgresql://whatdo:xxxxx@ep-foo-123456-pooler.ap-southeast-1.aws.neon.tech/whatdo?sslmode=require"
#   DIRECT_DATABASE_URL="postgresql://whatdo:xxxxx@ep-foo-123456.ap-southeast-1.aws.neon.tech/whatdo?sslmode=require"
#
# Scripts that use DIRECT_DATABASE_URL:
#   npm run db:push:direct      —  equivalent to DATABASE_URL=$DIRECT_DATABASE_URL prisma db push
#   npm run db:migrate:deploy   —  run against DIRECT_DATABASE_URL when present, else DATABASE_URL
#   npm run db:migrate:resolve  —  same fallback behavior
#   npm run db:migrate:reset    —  same
#   npm run db:studio:direct    —  prisma studio against direct
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatdo

# Paste Neon "Direct connection" here. The scripts above will prefer this;
# if empty they fall back to DATABASE_URL (works fine for local Postgres).
DIRECT_DATABASE_URL=

# Prisma accelerates global DB queries. Free tier 100k queries/month.
# Leave empty to skip (Prisma ORM works without it).
PRISMA_ACCELERATE_ENDPOINT=

# ——————————————————————————————————————————————————————————————
#  If you want to use LOCAL POSTGRES (Docker / brew install postgresql
#  instead of Neon) for a completely offline dev setup:
#
#    brew install postgresql@16 && brew services start postgresql@16
#    createdb whatdo
#
#  then set these 3 and DIRECT_DATABASE_URL can stay equal or empty:
#    DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatdo"
#    DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatdo"
#    SKIP_PG_SSL=1
# ——————————————————————————————————————————————————————————————

# ============================================================
# 3. AUTH — Auth.js (NextAuth v5)
# ============================================================
# Generate via: openssl rand -base64 32
# Keep this identical across Vercel Prod + Preview + Dev or sessions will break on deploy.
AUTH_SECRET=change-me-run-openssl-rand-base64-32

# Set in Vercel only; leave empty for local dev.
# Vercel AUTOMATICALLY exposes VERCEL_URL in Preview/Prod. Auth.js uses it for callback URLs.
# But set AUTH_URL explicitly to avoid edge cases. E.g. https://whatdo.app/api/auth
AUTH_URL=http://localhost:3000/api/auth

# --- Google OAuth (free tier) ---
# https://console.cloud.google.com/apis/credentials → OAuth 2.0 Client IDs
# Authorized redirect URI (production):
#   https://whatdo.app/api/auth/callback/google
# Authorized redirect URI (dev):
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Apple OAuth ($99/year Apple Developer Program required) ---
# Skip at launch. Users can still use Google + email/password.
# Docs: https://authjs.dev/getting-started/providers/apple
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Reserved for future providers ---
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ============================================================
# 4. MEDIA / OBJECT STORAGE — Cloudflare R2 (S3 compatible, ZERO egress $)
# ============================================================
# Create bucket at dash.cloudflare.com → R2 → Create bucket → name: whatdo-media
# In bucket → Settings → Custom Domains → connect media.whatdo.app (recommended)
# or use "Public bucket name" auto URL.
#
# Credentials: R2 → Manage R2 API Tokens → Create API token with "Object Read & Write"
# on the whatdo-media bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=whatdo-media
# Public URL. NO trailing slash. E.g. https://media.whatdo.app OR
# https://pub-<hex>.r2.dev (bucket auto public endpoint).
R2_PUBLIC_URL=
# Optional: If you use a different R2 S3 endpoint, override:
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# ============================================================
# 5. RATE LIMITING + CACHING — Upstash Redis Serverless (free tier)
# ============================================================
# console.upstash.com → Create Redis (Global) → REST API → Copy REST URL + Token
# Free: 10,000 commands/day, 256MB storage. Perfect for 0→10k users.
#
# If omitted, code falls back to in-memory dev rate limiter (works locally, not safe prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# 6. AI CONTENT MODERATION (optional at launch)
# ============================================================
# If empty, our MockAIProvider kicks in (wordlist-only NSFW/profanity flags).
# Provider values allowed today: mock | openai | azure-ai
AI_PROVIDER=mock
# OpenAI API key (platform.openai.com → API Keys). GPT-4o-mini ~$0.15/1M input tokens.
OPENAI_API_KEY=
# Azure AI Content Safety endpoint + key (optional). Leave empty if only OpenAI.
AZURE_AI_CONTENT_SAFETY_ENDPOINT=
AZURE_AI_CONTENT_SAFETY_KEY=

# ============================================================
# 7. ERROR MONITORING — Sentry (optional, free dev tier)
# ============================================================
# sentry.io → create Next.js project → paste DSN here.
# Free tier: 5k errors/month. Leave empty for no Sentry.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=whatdo
SENTRY_AUTH_TOKEN=

# ============================================================
# 8. ANALYTICS — PostHog (optional)
# ============================================================
# posthog.com → new project. Skip for launch; you can add after 100 DAU.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================================
# 9. EMAIL — Azure Communication Services / SMTP / Resend / Sendgrid
# ============================================================
# Pick ONE provider. Leave all empty = emails logged to console (dev mode).
#
# Option 1 — Resend (recommended at launch; $0 100 emails/day free tier forever):
#   resend.com → API Keys
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@whatdo.app
MAIL_FROM_NAME=WHATDO
#
# Option 2 — SMTP generic (Azure ACS / SendGrid / Postmark):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ============================================================
# 10. PRODUCTION FLAGS
# ============================================================
# Skip image optimization remote-domain warnings on builds for custom hostnames
# you add later — keep false unless you know you need it.
NEXT_TELEMETRY_DISABLED=1
# Force Prisma generation during Vercel build (handled by package.json prebuild too).
PRISMA_SKIP_POSTINSTALL_GENERATE=false
