{
  "name": "whatdo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,mdx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,mdx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "node scripts/prisma-env.mjs prisma db push",
    "db:push:direct": "node scripts/prisma-env.mjs --use-direct prisma db push",
    "db:migrate": "node scripts/prisma-env.mjs prisma migrate dev",
    "db:migrate:name": "node scripts/prisma-env.mjs prisma migrate dev --name",
    "db:migrate:deploy": "node scripts/prisma-env.mjs --use-direct prisma migrate deploy",
    "db:migrate:resolve": "node scripts/prisma-env.mjs --use-direct prisma migrate resolve",
    "db:migrate:reset": "node scripts/prisma-env.mjs --use-direct prisma migrate reset",
    "db:studio": "node scripts/prisma-env.mjs prisma studio",
    "db:studio:direct": "node scripts/prisma-env.mjs --use-direct prisma studio",
    "db:seed": "node scripts/prisma-env.mjs prisma db seed",
    "db:seed:examples": "npx tsx prisma/seed-curated-posts.ts",
    "vercel:pull": "vercel pull",
    "vercel:link": "vercel link",
    "vercel:dev": "vercel dev",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org example-org --project example-project ./.next && sentry-cli sourcemaps upload --org example-org --project example-project ./.next"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.2",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-s3": "^3.679.0",
    "@aws-sdk/s3-request-presigner": "^3.679.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.21.1",
    "@sentry/nextjs": "^8.35.0",
    "@smithy/protocol-http": "^4.1.8",
    "@smithy/signature-v4": "^5.7.3",
    "@tanstack/react-query": "^5.59.15",
    "@trpc/client": "^11.0.0-rc.593",
    "@trpc/next": "^11.0.0-rc.593",
    "@trpc/react-query": "^11.0.0-rc.593",
    "@trpc/server": "^11.0.0-rc.593",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "inngest": "^3.26.0",
    "lucide-react": "^0.453.0",
    "next": "^14.2.35",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^6.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "recharts": "^3.10.1",
    "superjson": "^2.2.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
